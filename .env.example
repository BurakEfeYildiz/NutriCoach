# NutriCoach Configuration

# Application Environment: 'development', 'local', 'test', or 'production'
# In 'production', secret keys cannot be defaults, SQLite is disallowed, and dev bootstrap is disabled.
APP_ENV=development

# Application Port (Cloud Run automatically provides PORT, default: 8080)
PORT=8080

# Database URL
# Local SQLite: sqlite:///./nutricoach.db
# Cloud SQL PostgreSQL: postgresql+psycopg2://USER:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# Standard PostgreSQL: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=sqlite:///./nutricoach.db

# Allowed Hosts (comma-separated or JSON list; e.g. *.run.app,nutricoach.example.com,localhost,127.0.0.1)
ALLOWED_HOSTS=*

# Security Secrets (MUST be changed in production to high-entropy random strings, e.g. `openssl rand -hex 32`)
SECRET_KEY=nutricoach-development-secret-change-in-production-min-32-chars
CSRF_SECRET=nutricoach-csrf-development-secret-change-in-prod-32-chars

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NUTRICOACH_GEMINI_TIMEOUT_SECONDS=30

# Chat & Context Tunables
NUTRICOACH_CHAT_RECENT_MESSAGES=10
NUTRICOACH_CHAT_HISTORY_CHARS=8000
